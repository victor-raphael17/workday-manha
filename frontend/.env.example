# Base URL the browser uses to reach the CA Pharmacy API.
# For local dev (`npm run dev`) and the dockerized stack this is the API's
# published port. Override at build time for other environments.
VITE_API_BASE_URL=http://localhost:8080

# Branch identity – set these for each deployment / location.
VITE_BRANCH_NAME=Riverside branch
VITE_BRANCH_SHIFT_LEAD=Jade Okafor
VITE_BRANCH_ROLE=Pharmacist